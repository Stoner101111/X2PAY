{
  "name": "xpay2win-agent",
  "version": "1.0.0",
  "description": "GIFTMAS - Reward distribution system for Solana tokens",
  "main": "dist/agent.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/agent.js",
    "start:prod": "cross-env NODE_ENV=production node dist/agent.js",
    "dev": "ts-node src/agent.ts",
    "watch": "ts-node --watch src/agent.ts",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "postbuild": "echo 'Build completed successfully'",
    "health": "curl -f http://localhost:3001/health || exit 1",
    "vercel-build": "npm run build"
  },
  "keywords": [
    "solana",
    "meme-coins",
    "pump-fun",
    "trading",
    "agent",
    "blockchain",
    "burn",
    "xpay2win",
    "token-burn",
    "deflationary"
  ],
  "author": "GIFTMAS Team",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/bs58": "^4.0.4",
    "axios": "^1.6.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

